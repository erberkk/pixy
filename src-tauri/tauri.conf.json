{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.widget.mascot",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "mascot",
        "title": "Mascot",
        "url": "mascot/index.html",
        "width": 740,
        "height": 620,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "workspace",
        "title": "Workspace",
        "url": "workspace/workspace.html",
        "width": 900,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "decorations": false,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings/settings.html",
        "width": 620,
        "height": 640,
        "minWidth": 520,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
